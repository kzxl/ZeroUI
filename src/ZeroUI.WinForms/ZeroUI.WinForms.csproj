<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net462;net8.0-windows</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <Description>Ultra-high-performance WinForms industrial UI suite with 10M+ rows virtual grid, ISA-18.2 alarms, P&amp;ID actuators, 60 FPS oscilloscope, and modern Obsidian Dark/Clean Light theme.</Description>
    <PackageTags>winforms;datagridview;grid;scada;hmi;industrial-automation;mes;plc;dark-theme;virtualization;zero-allocation</PackageTags>
    <Authors>Phong Võ</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/kzxl/ZeroUI</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZeroUI.Core\ZeroUI.Core.csproj" />
  </ItemGroup>

  <!-- Dual-mode resolution: ProjectReference for local monorepo, PackageReference for standalone CI / NuGet consumers -->
  <ItemGroup Condition="Exists('..\..\..\ZeroGraphics\src\ZeroGraphics.Core\ZeroGraphics.Core.csproj')">
    <ProjectReference Include="..\..\..\ZeroGraphics\src\ZeroGraphics.Core\ZeroGraphics.Core.csproj" />
    <ProjectReference Include="..\..\..\ZeroGraphics\src\ZeroGraphics.DirectX\ZeroGraphics.DirectX.csproj" />
    <ProjectReference Include="..\..\..\ZeroGraphics\src\ZeroGraphics.Direct2D\ZeroGraphics.Direct2D.csproj" />
    <ProjectReference Include="..\..\..\ZeroGraphics\src\ZeroGraphics.Waveform\ZeroGraphics.Waveform.csproj" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('..\..\..\ZeroGraphics\src\ZeroGraphics.Core\ZeroGraphics.Core.csproj')">
    <PackageReference Include="ZeroGraphics.Core" Version="1.0.0" />
    <PackageReference Include="ZeroGraphics.DirectX" Version="1.0.0" />
    <PackageReference Include="ZeroGraphics.Direct2D" Version="1.0.0" />
    <PackageReference Include="ZeroGraphics.Waveform" Version="1.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Icons\*.bmp" />
  </ItemGroup>
</Project>
