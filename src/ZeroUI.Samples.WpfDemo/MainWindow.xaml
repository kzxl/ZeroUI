                                                        <overlay:ZeroFlyout.FlyoutContent>
                                                            <StackPanel Width="220">
                                                                <TextBlock Text="Select target telemetry channels:" FontSize="11.5" Foreground="{DynamicResource ZeroUI.TextSecondary}" Margin="0,0,0,8" />
                                                                <CheckBox Content="DirectX GPU Canvas" IsChecked="True" Margin="0,0,0,4" />
                                                                <CheckBox Content="Modbus TCP / RTU" IsChecked="True" Margin="0,0,0,4" />
                                                                <CheckBox Content="OPC UA Server Line 1" IsChecked="False" Margin="0,0,0,8" />
                                                                <Button Content="Apply Filter" Height="28" Click="OnApplyFlyoutFilterClicked" />
                                                            </StackPanel>
                                                        </overlay:ZeroFlyout.FlyoutContent>
                                                    </overlay:ZeroFlyout>
                                                </Grid>

                                                <TextBlock Text="Frameless Window Demo:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ZeroUI.TextSecondary}" Margin="0,0,0,8" />
                                                <Button Content="🚀 Launch Frameless ZeroWindow Demo" Height="34" HorizontalAlignment="Left" Padding="14,0,14,0" Click="OnLaunchZeroWindowClicked" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- StatusBar & Separator Showcase -->
                                    <TextBlock Text="4. StatusBar &amp; Separator" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource ZeroUI.TextPrimary}" Margin="0,0,0,12" />
                                    <Border BorderThickness="1" BorderBrush="{DynamicResource ZeroUI.BorderDefault}" CornerRadius="6" Background="{DynamicResource ZeroUI.BgCard}" Padding="16">
                                        <StackPanel>
                                            <TextBlock Text="Standard WPF StatusBar with dynamic theme colors and subtle top border:" Foreground="{DynamicResource ZeroUI.TextSecondary}" Margin="0,0,0,10" />
                                            <StatusBar>
                                                <StatusBarItem>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="●" Foreground="{DynamicResource ZeroUI.SuccessAccent}" Margin="0,0,6,0" />
                                                        <TextBlock Text="System Operational" />
                                                    </StackPanel>
                                                </StatusBarItem>
                                                <Separator />
                                                <StatusBarItem Content="Active Nodes: 128 / 128" />
                                                <Separator />
                                                <StatusBarItem Content="Throughput: 10.4 MB/s" />
                                                <Separator />
                                                <StatusBarItem HorizontalAlignment="Right" Content="WPF .NET 8 / 4.6.2 Engine" />
                                            </StatusBar>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- Global Detail Drawer Overlay -->
        <overlay:ZeroDrawer x:Name="MainDetailDrawer" Grid.RowSpan="2" DrawerWidth="420"
                            Title="Inspection Drawer"
                            Subtitle="Material &amp; Quality Parameters">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,4,0,16">
                    <TextBlock Text="METADATA SPECIFICATION" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ZeroUI.TextSecondary}" Margin="0,0,0,10" />
                    
                    <Border BorderThickness="1" BorderBrush="{DynamicResource ZeroUI.BorderDefault}" CornerRadius="6" Padding="14" Margin="0,0,0,16" Background="{DynamicResource ZeroUI.BgSecondary}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Item Code" Foreground="{DynamicResource ZeroUI.TextSecondary}" FontSize="12" />
                                <TextBlock x:Name="DrawerItemCode" Text="MAT-BOA-492" FontWeight="SemiBold" Foreground="{DynamicResource ZeroUI.TextPrimary}" HorizontalAlignment="Right" FontSize="12" />
                            </DockPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Description" Foreground="{DynamicResource ZeroUI.TextSecondary}" FontSize="12" />
                                <TextBlock x:Name="DrawerItemName" Text="Microcontroller MCU-32" FontWeight="SemiBold" Foreground="{DynamicResource ZeroUI.TextPrimary}" HorizontalAlignment="Right" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                            </DockPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Category" Foreground="{DynamicResource ZeroUI.TextSecondary}" FontSize="12" />
                                <TextBlock x:Name="DrawerCategory" Text="Active / SMT Component" FontWeight="SemiBold" Foreground="{DynamicResource ZeroUI.TextPrimary}" HorizontalAlignment="Right" FontSize="12" />
                            </DockPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Stock Quantity" Foreground="{DynamicResource ZeroUI.TextSecondary}" FontSize="12" />
                                <TextBlock x:Name="DrawerQuantity" Text="14,250 Units" FontWeight="Bold" Foreground="{DynamicResource ZeroUI.PrimaryAccent}" HorizontalAlignment="Right" FontSize="12" />
                            </DockPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Unit Price" Foreground="{DynamicResource ZeroUI.TextSecondary}" FontSize="12" />
                                <TextBlock x:Name="DrawerUnitPrice" Text="$128.50" FontWeight="SemiBold" Foreground="{DynamicResource ZeroUI.TextPrimary}" HorizontalAlignment="Right" FontSize="12" />
                            </DockPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Total Valuation" Foreground="{DynamicResource ZeroUI.TextSecondary}" FontSize="12" />
                                <TextBlock x:Name="DrawerTotalAmount" Text="$1,831,125.00" FontWeight="SemiBold" Foreground="{DynamicResource ZeroUI.TextPrimary}" HorizontalAlignment="Right" FontSize="12" />
                            </DockPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Lot Number" Foreground="{DynamicResource ZeroUI.TextSecondary}" FontSize="12" />
                                <TextBlock x:Name="DrawerLotNumber" Text="LOT-202609" FontWeight="SemiBold" Foreground="{DynamicResource ZeroUI.TextPrimary}" HorizontalAlignment="Right" FontSize="12" />
                            </DockPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Yield Rate" Foreground="{DynamicResource ZeroUI.TextSecondary}" FontSize="12" />
                                <TextBlock x:Name="DrawerYieldRate" Text="98.5%" FontWeight="SemiBold" Foreground="#10B981" HorizontalAlignment="Right" FontSize="12" />
                            </DockPanel>
                            <DockPanel>
                                <TextBlock Text="Inspection Status" Foreground="{DynamicResource ZeroUI.TextSecondary}" FontSize="12" />
                                <TextBlock x:Name="DrawerStatus" Text="PASSED (OQC-A1)" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Right" FontSize="12" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="INVENTORY OPERATIONS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ZeroUI.TextSecondary}" Margin="0,0,0,10" />
                    <Button x:Name="BtnDrawerDispatch" Click="BtnDrawerDispatch_Click" Content="⚡ Request Express Dispatch" Height="34" Margin="0,0,0,8" Cursor="Hand" FontWeight="SemiBold" />
                    <Button x:Name="BtnDrawerPrintLabel" Click="BtnDrawerPrintLabel_Click" Content="🖨️ Print Lot Barcode Label" Height="34" Margin="0,0,0,8" Cursor="Hand" />
                    <Button x:Name="BtnDrawerAuditLog" Click="BtnDrawerAuditLog_Click" Content="📜 View Quality Audit Trail" Height="34" Cursor="Hand" />
                </StackPanel>
            </ScrollViewer>
        </overlay:ZeroDrawer>
    </Grid>
</Window>
