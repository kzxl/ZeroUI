                                <TextBlock Text="📅 Industrial Production Gantt Schedule (ZeroGanttChart)" FontSize="15" FontWeight="Bold" Foreground="#818CF8" />
                                <TextBlock Text="Interactive timeline with task bars, milestone diamonds, predecessor dependency links, and completion %" FontSize="11.5" Foreground="#94A3B8" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                <Button x:Name="BtnGanttZoomIn" Click="BtnGanttZoomIn_Click" Content="🔍+ Zoom In" Height="28" Padding="10,0,10,0" Margin="0,0,6,0" Cursor="Hand" />
                                <Button x:Name="BtnGanttZoomOut" Click="BtnGanttZoomOut_Click" Content="🔍- Zoom Out" Height="28" Padding="10,0,10,0" Margin="0,0,12,0" Cursor="Hand" />
                                <Button x:Name="BtnGanttAddDemo" Click="BtnGanttAddDemo_Click" Content="➕ Add Task" Height="28" Padding="10,0,10,0" Cursor="Hand" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1" CornerRadius="6" BorderThickness="1" BorderBrush="#2E344E">
                        <ind:ZeroGanttChart x:Name="DemoGanttChart" />
                    </Border>
                </Grid>
            </TabItem>

            <!-- CLUSTER 10: DOCK MANAGER & DIAGRAM CANVAS -->
            <TabItem Header="🏗️ 10. Docking &amp; Diagram Studio">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Margin="0,0,0,12" Background="#181B26" Padding="14,10,14,10" CornerRadius="6" BorderThickness="1" BorderBrush="#2E344E">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="🏗️ Visual Studio-Style Docking Manager &amp; P&amp;ID Flow Canvas" FontSize="15" FontWeight="Bold" Foreground="#818CF8" />
                                <TextBlock Text="Drag nodes, connect port pins with Bezier pipes, pan/zoom canvas, resize docking panels with splitters" FontSize="11.5" Foreground="#94A3B8" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                <Button x:Name="BtnAddNode" Click="BtnAddNode_Click" Content="➕ Add Station Node" Height="28" Padding="10,0,10,0" Margin="0,0,6,0" Cursor="Hand" />
                                <Button x:Name="BtnResetDiagram" Click="BtnResetDiagram_Click" Content="🔄 Reset Layout" Height="28" Padding="10,0,10,0" Cursor="Hand" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1" CornerRadius="6" BorderThickness="1" BorderBrush="#2E344E">
                        <dock:ZeroDockManager x:Name="DemoDockManager" />
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
