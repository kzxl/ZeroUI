<Window x:Class="ZeroUI.Samples.WpfDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:grid="clr-namespace:ZeroUI.Wpf.DataGrid;assembly=ZeroUI.Wpf"
        xmlns:chart="clr-namespace:ZeroUI.Wpf.Charts;assembly=ZeroUI.Wpf"
        xmlns:ind="clr-namespace:ZeroUI.Wpf.Industrial;assembly=ZeroUI.Wpf"
        xmlns:wh="clr-namespace:ZeroUI.Wpf.Warehouse;assembly=ZeroUI.Wpf"
        xmlns:edit="clr-namespace:ZeroUI.Wpf.Editors;assembly=ZeroUI.Wpf"
        xmlns:tree="clr-namespace:ZeroUI.Wpf.TreeList;assembly=ZeroUI.Wpf"
        xmlns:prop="clr-namespace:ZeroUI.Wpf.PropertyGrid;assembly=ZeroUI.Wpf"
        xmlns:nav="clr-namespace:ZeroUI.Wpf.Navigation;assembly=ZeroUI.Wpf"
        xmlns:dock="clr-namespace:ZeroUI.Wpf.Docking;assembly=ZeroUI.Wpf"
        xmlns:diag="clr-namespace:ZeroUI.Wpf.Diagram;assembly=ZeroUI.Wpf"
        xmlns:feed="clr-namespace:ZeroUI.Wpf.Feedback;assembly=ZeroUI.Wpf"
        xmlns:overlay="clr-namespace:ZeroUI.Wpf.Overlays;assembly=ZeroUI.Wpf"
        xmlns:layout="clr-namespace:ZeroUI.Wpf.Layout;assembly=ZeroUI.Wpf"
        xmlns:report="clr-namespace:ZeroUI.Wpf.Reporting;assembly=ZeroUI.Wpf"
        xmlns:pivot="clr-namespace:ZeroUI.Wpf.PivotGrid;assembly=ZeroUI.Wpf"
        xmlns:range="clr-namespace:ZeroUI.Wpf.Range;assembly=ZeroUI.Wpf"
        xmlns:energy="clr-namespace:ZeroUI.Wpf.Energy;assembly=ZeroUI.Wpf"
        xmlns:petro="clr-namespace:ZeroUI.Wpf.Petrochem;assembly=ZeroUI.Wpf"
        xmlns:proc="clr-namespace:ZeroUI.Wpf.Process;assembly=ZeroUI.Wpf"
        xmlns:water="clr-namespace:ZeroUI.Wpf.Water;assembly=ZeroUI.Wpf"
        xmlns:bms="clr-namespace:ZeroUI.Wpf.Bms;assembly=ZeroUI.Wpf"
        xmlns:life="clr-namespace:ZeroUI.Wpf.LifeSciences;assembly=ZeroUI.Wpf"
        xmlns:log="clr-namespace:ZeroUI.Wpf.Logistics;assembly=ZeroUI.Wpf"
        xmlns:net="clr-namespace:ZeroUI.Wpf.Network;assembly=ZeroUI.Wpf"
        xmlns:rend="clr-namespace:ZeroUI.Wpf.Rendering;assembly=ZeroUI.Wpf"
        xmlns:opt="clr-namespace:ZeroUI.Wpf.Rendering.Optimizer;assembly=ZeroUI.Wpf"
        Title="ZeroUI ⚡ High-Performance Enterprise Desktop Suite (WPF)" Height="920" Width="1440"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="54" /> <!-- Master Top Header -->
            <RowDefinition Height="*" />  <!-- Master 7-Cluster Workspace -->
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border x:Name="HeaderBar" Grid.Row="0" BorderThickness="0,0,0,1" Padding="20,0,20,0">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                    <TextBlock Text="⚡ ZeroUI" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource ZeroUI.PrimaryAccent}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock Text="Enterprise High-Performance Zero-Alloc WPF Control Suite" FontSize="12.5" Foreground="{DynamicResource ZeroUI.TextSecondary}" VerticalAlignment="Center" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="🎨 Skin:" VerticalAlignment="Center" Foreground="{DynamicResource ZeroUI.TextSecondary}" Margin="0,0,6,0" FontSize="12.5" FontWeight="SemiBold" />
                    <ComboBox x:Name="ComboSkinSelector" Width="175" Height="30" Margin="0,0,10,0" SelectionChanged="ComboSkinSelector_SelectionChanged" />
                    <Button x:Name="BtnToggleHUD" Click="BtnToggleHUD_Click" Content="⚡ HUD" Height="30" Padding="10,0,10,0" Margin="0,0,8,0" Cursor="Hand" FontWeight="SemiBold" ToolTip="Toggle Render Optimizer Diagnostics HUD" />
                    <Button x:Name="BtnDetailDrawer" Click="BtnDetailDrawer_Click" Content="📋 Detail Drawer" Height="30" Padding="12,0,12,0" Margin="0,0,8,0" Cursor="Hand" FontWeight="SemiBold" />
                    <Button x:Name="BtnSkinStudio" Click="BtnSkinStudio_Click" Content="🎨 Skin Studio" Height="30" Padding="12,0,12,0" Margin="0,0,8,0" Cursor="Hand" FontWeight="SemiBold" />
                    <Button x:Name="BtnAbout" Click="BtnAbout_Click" Content="ℹ️ Architecture" Height="30" Padding="12,0,12,0" Cursor="Hand" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Master 7-Cluster Workspace with Left Navigation Rail -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" /> <!-- Left Rail Nav -->
                <ColumnDefinition Width="*" />    <!-- Cluster Content Workspace -->
            </Grid.ColumnDefinitions>

            <!-- Floating Render Optimizer Diagnostics HUD -->
            <opt:ZeroRenderOptimizerHUD x:Name="MasterHUD" Grid.ColumnSpan="2" Panel.ZIndex="999" IsExpanded="True" Margin="0,16,24,0" Visibility="Collapsed" />

            <!-- Left Navigation Rail: 7 Primary Clusters -->
            <nav:SideNav x:Name="MainNavRail" Grid.Column="0"
                         BrandTitle="Navigation" BrandSubtitle="Enterprise Clusters" BrandLogo="⚡"
                         Width="240" />

            <!-- Master 7-Cluster Tab Workspace -->
            <TabControl x:Name="MainTabs" Grid.Column="1" BorderThickness="0" Margin="0">
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Style>
                </TabControl.ItemContainerStyle>

                <!-- ========================================================================= -->
                <!-- CLUSTER 1: BIG DATA & GRIDS                                               -->
                <!-- ========================================================================= -->
                <TabItem Header="⚡ Big Data &amp; Grids">
                    <TabControl BorderThickness="0" Margin="0">
                        <!-- Sub-Tab 1.1: ZeroGrid 10M Benchmark -->
                        <TabItem Header="⚡ 10M Virtual Grid Benchmark">
                            <Grid x:Name="GridWorkspace">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /> <!-- Telemetry HUD -->
                                    <RowDefinition Height="Auto" /> <!-- Action Toolbar -->
                                    <RowDefinition Height="Auto" /> <!-- Search Bar -->
                                    <RowDefinition Height="*" />    <!-- ZeroGridControl -->
                                    <RowDefinition Height="Auto" /> <!-- Pagination -->
                                </Grid.RowDefinitions>

                                <!-- Telemetry HUD Banner -->
                                <Border x:Name="HudBorder" Grid.Row="0" Margin="14,10,14,6" Padding="18,10,18,10" CornerRadius="8" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="VIEWPORT COMPUTE RATE" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ZeroUI.TextMuted}" />
                                            <TextBlock x:Name="TxtFps" Text="-- FPS" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource ZeroUI.PrimaryAccent}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="SCROLL LATENCY" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ZeroUI.TextMuted}" />
                                            <TextBlock x:Name="TxtLatency" Text="0.032 ms" FontSize="19" FontWeight="Bold" Foreground="#A6E3A1" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="GC GEN 0 / 1 / 2 (DELTA)" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ZeroUI.TextMuted}" />
                                            <TextBlock x:Name="TxtGc" Text="0 / 0 / 0" FontSize="19" FontWeight="Bold" Foreground="#F9E2AF" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="3">
                                            <TextBlock Text="WORKING SET RAM" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ZeroUI.TextMuted}" />
                                            <TextBlock x:Name="TxtRam" Text="-- MB" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource ZeroUI.TextSecondary}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="ACTIVE DATA CAPACITY" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ZeroUI.TextMuted}" />
                                            <TextBlock x:Name="TxtCapacity" Text="0 Rows" FontSize="19" FontWeight="Bold" Foreground="#A78BFA" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Action Toolbar -->
                                <WrapPanel Grid.Row="1" Margin="14,4,14,6">
                                    <Button x:Name="BtnLoad100K" Click="BtnLoad100K_Click" Content="⚡ Load 100K Rows" Height="32" Padding="14,0,14,0" Margin="0,0,8,6" Cursor="Hand" />
                                    <Button x:Name="BtnLoad1M" Click="BtnLoad1M_Click" Content="🔥 Load 1,000,000 Rows" Height="32" Padding="14,0,14,0" Margin="0,0,8,6" Cursor="Hand" />
                                    <Button x:Name="BtnLoad10M" Click="BtnLoad10M_Click" Content="🚀 10,000,000 Rows (Procedural)" Height="32" Padding="14,0,14,0" Margin="0,0,8,6" Cursor="Hand" />
                                    <Button x:Name="BtnGroupCategory" Click="BtnGroupCategory_Click" Content="📂 Group by Category" Height="32" Padding="12,0,12,0" Margin="0,0,8,6" Cursor="Hand" />
                                    <Button x:Name="BtnClearGrouping" Click="BtnClearGrouping_Click" Content="🔄 Clear Grouping" Height="32" Padding="12,0,12,0" Margin="0,0,8,6" Cursor="Hand" />
                                    <Button x:Name="BtnToggleExpand" Click="BtnToggleExpand_Click" Content="↕️ Toggle Expand All" Height="32" Padding="12,0,12,0" Margin="0,0,8,6" Cursor="Hand" />
                                    <Button x:Name="BtnSortPrice" Click="BtnSortPrice_Click" Content="📊 Sort UnitPrice" Height="32" Padding="12,0,12,0" Margin="0,0,8,6" Cursor="Hand" />
                                    <Button x:Name="BtnSortQuantity" Click="BtnSortQuantity_Click" Content="📦 Sort Quantity" Height="32" Padding="12,0,12,0" Margin="0,0,8,6" Cursor="Hand" />
                                    <Button x:Name="BtnTogglePinning" Click="BtnTogglePinning_Click" Content="📌 Toggle Pinning" Height="32" Padding="12,0,12,0" Margin="0,0,8,6" Cursor="Hand" />
                                    <Button x:Name="BtnToggleFooter" Click="BtnToggleFooter_Click" Content="∑ Toggle Footer" Height="32" Padding="12,0,12,0" Margin="0,0,8,6" Cursor="Hand" />
                                    <Button x:Name="BtnToggleGroupPanel" Click="BtnToggleGroupPanel_Click" Content="🗂️ Group Panel" Height="32" Padding="12,0,12,0" Margin="0,0,8,6" Cursor="Hand" />
                                    <Button x:Name="BtnToggleSummaries" Click="BtnToggleSummaries_Click" Content="∑ Group Subtotals" Height="32" Padding="12,0,12,0" Margin="0,0,8,6" Cursor="Hand" />
                                    <Button x:Name="BtnLoadGenericList" Click="BtnLoadGenericList_Click" Content="🧬 Generic List (5K)" Height="32" Padding="12,0,12,0" Margin="0,0,8,6" Cursor="Hand" />
                                    <Button x:Name="BtnBandedHeaders" Click="BtnBandedHeaders_Click" Content="🏛️ Multi-Tier Bands" Height="32" Padding="12,0,12,0" Margin="0,0,8,6" Cursor="Hand" />
                                    <Button x:Name="BtnBlockSelection" Click="BtnBlockSelection_Click" Content="📐 Block Marquee" Height="32" Padding="12,0,12,0" Margin="0,0,8,6" Cursor="Hand" />
                                    <Button x:Name="BtnClearGrid" Click="BtnClearGrid_Click" Content="🗑️ Clear Grid" Height="32" Padding="12,0,12,0" Margin="0,0,8,6" Cursor="Hand" />
                                </WrapPanel>

                                <!-- Search Bar & Hint -->
                                <StackPanel Grid.Row="2" Margin="14,0,14,6">
                                    <grid:ZeroGridSearchBar x:Name="GridSearch" />
                                    <TextBlock Margin="2,4,0,0" FontSize="11.5" Foreground="{DynamicResource ZeroUI.TextSecondary}"
                                               Text="💡 Drag headers into Group Panel to group | Click [✕] to remove group | Header [▼] for Excel distinct filter | In-Place Editing: F2 | In-Cell DataBars: Live % visual" />
                                </StackPanel>

                                <!-- ZeroGridControl -->
                                <Border Grid.Row="3" Margin="14,0,14,0" BorderThickness="1" BorderBrush="{DynamicResource ZeroUI.BorderDefault}">
                                    <grid:ZeroGridControl x:Name="VirtualGrid" ShowGroupPanel="True" />
                                </Border>

                                <!-- Pagination -->
                                <grid:ZeroGridPagination x:Name="GridPager" Grid.Row="4" Margin="14,0,14,10" />
                            </Grid>
                        </TabItem>

                        <!-- Sub-Tab 1.2: OLAP Pivot Grid -->
                        <TabItem Header="📊 OLAP Pivot Grid (Multidimensional)">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <Grid Margin="16">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="380" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="380" />
                                    </Grid.RowDefinitions>

                                    <!-- Section A: ZeroPivotGrid Standard Cross-Tab -->
                                    <Border Grid.Row="0" Margin="0,0,0,12" Background="{DynamicResource ZeroUI.BgCard}" Padding="14,10,14,10" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource ZeroUI.BorderDefault}">
                                        <DockPanel LastChildFill="False">
                                            <StackPanel DockPanel.Dock="Left">
                                                <TextBlock Text="📊 Multi-Dimensional OLAP Pivot Grid (ZeroPivotGrid)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ZeroUI.PrimaryAccent}" />
                                                <TextBlock Text="Cross-tab multi-axis slicing: Region × Quarter with live Grand Totals and dynamic aggregation (Sum / Count / Average)" FontSize="11.5" Foreground="{DynamicResource ZeroUI.TextSecondary}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                                <TextBlock Text="Aggregation:" VerticalAlignment="Center" Foreground="{DynamicResource ZeroUI.TextSecondary}" Margin="0,0,8,0" FontSize="12" />
                                                <ComboBox x:Name="ComboPivotAgg" Width="120" Height="28" SelectionChanged="ComboPivotAgg_SelectionChanged" Margin="0,0,12,0" />
                                                <Button x:Name="BtnRefreshPivot" Click="BtnRefreshPivot_Click" Content="🔄 Regenerate Data" Height="28" Padding="12,0,12,0" Cursor="Hand" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>

                                    <Border Grid.Row="1" Margin="0,0,0,16" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource ZeroUI.BorderDefault}">
                                        <ind:ZeroPivotGrid x:Name="DemoPivotGrid" />
                                    </Border>

                                    <!-- Section B: PivotGridControl Commercial Hierarchical Slicing -->
                                    <Border Grid.Row="2" Margin="0,0,0,12" Background="{DynamicResource ZeroUI.BgCard}" Padding="14,10,14,10" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource ZeroUI.BorderDefault}">
                                        <StackPanel>
                                            <TextBlock Text="🏢 Enterprise OLAP Pivot Suite (PivotGridControl)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ZeroUI.PrimaryAccent}" />
                                            <TextBlock Text="Dynamic row/column hierarchical slicing, measure aggregations, sub-totals, and grand totals" FontSize="11.5" Foreground="{DynamicResource ZeroUI.TextSecondary}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="3" Margin="0,0,0,16" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource ZeroUI.BorderDefault}">
                                        <pivot:PivotGridControl x:Name="EnterprisePivotGrid" />
                                    </Border>
                                </Grid>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Sub-Tab 1.3: TreeList & PropertyGrid -->
                        <TabItem Header="🌲 TreeList &amp; PropertyGrid">
                            <Grid Margin="16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /> <!-- Breadcrumb Bar -->
                                    <RowDefinition Height="*" />    <!-- Split Workspaces -->
                                </Grid.RowDefinitions>

                                <!-- Breadcrumb Navigation Bar -->
                                <Border Grid.Row="0" Margin="0,0,0,14" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource ZeroUI.BorderDefault}">
                                    <nav:ZeroBreadcrumb x:Name="DemoBreadcrumb" Path="Enterprise Plant / Shopfloor North / Production Line 01 / Robotic Cell A" />
                                </Border>

                                <!-- Master-Detail Split Workspace -->
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*" MinWidth="320" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="2*" MinWidth="280" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: ZeroTreeList Multi-Column Hierarchical Explorer -->
                                    <Border Grid.Column="0" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource ZeroUI.BorderDefault}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" Background="{DynamicResource ZeroUI.BgCard}" Padding="12,8,12,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ZeroUI.BorderDefault}">
                                                <DockPanel LastChildFill="False">
                                                    <TextBlock Text="🌲 Plant Asset &amp; BOM Hierarchy (ZeroTreeList)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ZeroUI.PrimaryAccent}" VerticalAlignment="Center" />
                                                    <Button x:Name="BtnExpandAllTree" Click="BtnExpandAllTree_Click" Content="↕️ Expand All" Padding="10,2,10,2" DockPanel.Dock="Right" Margin="6,0,0,0" Cursor="Hand" />
                                                    <Button x:Name="BtnCollapseAllTree" Click="BtnCollapseAllTree_Click" Content="↕️ Collapse All" Padding="10,2,10,2" DockPanel.Dock="Right" Cursor="Hand" />
                                                </DockPanel>
                                            </Border>
                                            <tree:ZeroTreeList x:Name="DemoTreeList" Grid.Row="1" />
                                        </Grid>
                                    </Border>

                                    <!-- Splitter -->
                                    <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE" />

                                    <!-- Right: ZeroPropertyGrid Categorized Settings Inspector -->
                                    <Border Grid.Column="2" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource ZeroUI.BorderDefault}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" Background="{DynamicResource ZeroUI.BgCard}" Padding="12,8,12,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ZeroUI.BorderDefault}">
                                                <TextBlock Text="⚙️ Node Properties &amp; Telemetry (ZeroPropertyGrid)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ZeroUI.PrimaryAccent}" VerticalAlignment="Center" />
                                            </Border>
                                            <prop:ZeroPropertyGrid x:Name="DemoPropertyGrid" Grid.Row="1" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </TabItem>

                <!-- ========================================================================= -->
                <!-- CLUSTER 2: INDUSTRIAL VERTICALS                                           -->
                <!-- ========================================================================= -->
                <TabItem Header="🏭 Industrial Verticals">
                    <TabControl BorderThickness="0" Margin="0">
                        <!-- Sub-Tab 2.1: Energy & Smart Grid -->
                        <TabItem Header="⚡ Energy &amp; Smart Grid">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <Grid Margin="16">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,14" Background="{DynamicResource ZeroUI.BgCard}" Padding="14,10,14,10" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource ZeroUI.BorderDefault}">
                                        <StackPanel>
                                            <TextBlock Text="⚡ IEC 61850 Substation &amp; Smart Energy Grid Suite" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ZeroUI.PrimaryAccent}" />
                                            <TextBlock Text="Single-Line Diagram (SLD) topology, Vacuum Circuit Breaker (VCB) faceplate, BESS rack storage, and Solar PV string monitoring" FontSize="11.5" Foreground="{DynamicResource ZeroUI.TextSecondary}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Row 1: SLD & BESS Rack -->
                                    <ind:ZeroCard Grid.Row="1" Grid.Column="0" HeaderText="Single-Line Diagram (IEC 61850 SLD)" SubtitleText="High/Medium Voltage Substation Topology &amp; Flow" Margin="0,0,8,12">
                                        <energy:SingleLineDiagram Height="320" Margin="0,6,0,0" />
                                    </ind:ZeroCard>

                                    <ind:ZeroCard Grid.Row="1" Grid.Column="1" HeaderText="BESS Rack Monitor" SubtitleText="Grid-Scale Battery Energy Storage Rack &amp; Cell Telemetry" Margin="8,0,0,12">
                                        <energy:BessRackMonitor Height="320" Margin="0,6,0,0" />
                                    </ind:ZeroCard>

                                    <!-- Row 2: Switchgear & Solar PV Matrix -->
                                    <ind:ZeroCard Grid.Row="2" Grid.Column="0" HeaderText="Switchgear Faceplate" SubtitleText="Vacuum Circuit Breaker (VCB) &amp; Protection Relay" Margin="0,0,8,0">
                                        <energy:SwitchgearFaceplate Height="320" Margin="0,6,0,0" />
                                    </ind:ZeroCard>

                                    <ind:ZeroCard Grid.Row="2" Grid.Column="1" HeaderText="Solar PV Matrix" SubtitleText="String Inverter Health, DC/AC Watts &amp; Solar Irradiance" Margin="8,0,0,0">
                                        <energy:SolarPvMatrix Height="320" Margin="0,6,0,0" />
                                    </ind:ZeroCard>
                                </Grid>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Sub-Tab 2.2: Oil & Gas / Petrochem -->
                        <TabItem Header="🛢️ Oil &amp; Gas / Petrochem">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <Grid Margin="16">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="420" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,14" Background="{DynamicResource ZeroUI.BgCard}" Padding="14,10,14,10" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource ZeroUI.BorderDefault}">
                                        <StackPanel>
                                            <TextBlock Text="🛢️ Refining &amp; Petrochemical Engineering Suite" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ZeroUI.PrimaryAccent}" />
                                            <TextBlock Text="Distillation Fractionation Column, SIL 1-4 Cause &amp; Effect Matrix, and Pipeline PIG Inline Inspection (ILI) Telemetry" FontSize="11.5" Foreground="{DynamicResource ZeroUI.TextSecondary}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Left Column: Distillation Column -->
                                    <ind:ZeroCard Grid.Row="1" Grid.Column="0" HeaderText="Fractionation Distillation Column" SubtitleText="Tray Hydraulics, Thermal Gradient, Reflux &amp; Reboiler" Margin="0,0,12,0">
                                        <petro:DistillationColumn Height="660" Margin="0,6,0,0" />
                                    </ind:ZeroCard>

                                    <!-- Right Column: ESD Matrix & PIG Monitor -->
                                    <Grid Grid.Row="1" Grid.Column="1">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="350" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <ind:ZeroCard Grid.Row="0" HeaderText="Emergency Shutdown (ESD) Cause &amp; Effect Matrix" SubtitleText="IEC 61508 / IEC 61511 Safety Instrumented System (SIS) SIL 1-4" Margin="0,0,0,12">
                                            <petro:EsdMatrix Height="300" Margin="0,6,0,0" />
                                        </ind:ZeroCard>

                                        <ind:ZeroCard Grid.Row="1" HeaderText="Pipeline PIG Tracker &amp; Defect Inspection" SubtitleText="Inline Inspection (ILI) Ultrasonic Wall Loss, Geometry &amp; Acoustic Telemetry">
                                            <petro:PipelinePigMonitor Height="300" Margin="0,6,0,0" />
                                        </ind:ZeroCard>
                                    </Grid>
                                </Grid>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Sub-Tab 2.3: Pharma & Biotech ISA-88 -->
                        <TabItem Header="🧬 Pharma &amp; Biotech (ISA-88)">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <Grid Margin="16">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

